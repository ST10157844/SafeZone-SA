<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sz_bg">

    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:alpha="0">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp">
            <View
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_icon_container"/>
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shield"
                android:contentDescription="SafeZone Shield"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SafeZone SA"
            android:textColor="@color/sz_text"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Community Safety Platform"
            android:textColor="@color/sz_muted"
            android:textSize="13sp"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.08"/>

    </LinearLayout>

</FrameLayout>
