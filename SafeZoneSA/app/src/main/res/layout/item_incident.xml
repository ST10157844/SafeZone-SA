<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- Type and status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvIncidentType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Incident Type"
            android:textColor="@color/sz_text"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvIncidentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending"
            android:textColor="@color/sz_accent"
            android:textSize="11sp"
            android:textStyle="bold"/>

    </LinearLayout>


    <!-- Description -->
    <TextView
        android:id="@+id/tvIncidentDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Incident description"
        android:textColor="@color/sz_muted"
        android:textSize="12sp"
        android:layout_marginTop="8dp"
        android:maxLines="3"/>


    <!-- Location -->
    <TextView
        android:id="@+id/tvIncidentLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pretoria"
        android:textColor="@color/sz_text"
        android:textSize="12sp"
        android:layout_marginTop="12dp"/>


    <!-- Bottom information -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tvIncidentPriority"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Priority: Medium"
            android:textColor="@color/sz_muted"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/tvIncidentDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026-10-14"
            android:textColor="@color/sz_muted"
            android:textSize="10sp"/>

    </LinearLayout>

</LinearLayout>